<Window x:Class="AISelectionAssistant.App.Response.ResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Response"
        Height="520"
        Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="AI Response" FontSize="20" FontWeight="SemiBold" />
            <Button Content="Pin" DockPanel.Dock="Right" Width="72" />
        </DockPanel>
        <Border Grid.Row="1" Margin="0,16" Padding="16" Background="#F8FAFC" CornerRadius="12">
            <ScrollViewer>
                <TextBlock Text="Streaming markdown response appears here." TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="2">
            <Button Content="Copy" Width="72" Margin="0,0,8,0" />
            <Button Content="Regenerate" Width="96" Margin="0,0,8,0" />
            <Button Content="Switch Model" Width="112" />
        </DockPanel>
    </Grid>
</Window>
