<Window x:Class="AISelectionAssistant.App.Overlay.FloatingSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Selection Assistant"
        Width="220"
        Height="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border CornerRadius="18" Background="White" Padding="14">
        <StackPanel>
            <TextBlock Text="AI Actions" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Button Content="Explain" Margin="0,0,0,8" />
            <Button Content="Translate" Margin="0,0,0,8" />
            <Button Content="Summarize" Margin="0,0,0,8" />
            <Button Content="Rewrite" Margin="0,0,0,8" />
            <Button Content="Grammar Fix" Margin="0,0,0,8" />
            <Button Content="Ask AI" />
        </StackPanel>
    </Border>
</Window>
