<Window x:Class="AISelectionAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AISelectionAssistant.App"
        mc:Ignorable="d"
        Title="AI Selection Assistant" Height="560" Width="920"
        Background="{StaticResource AssistantBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="AI Selection Assistant"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AssistantTextBrush}" />
            <TextBlock Text="Global Windows text selection assistant scaffold"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="{StaticResource AssistantMutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Padding="24"
                CornerRadius="20"
                Background="{StaticResource AssistantSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Sidebar actions"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AssistantTextBrush}" />
                    <UniformGrid Columns="1" Margin="0,16,0,0">
                        <Button Content="Explain" Margin="0,0,0,8" Padding="12" />
                        <Button Content="Translate" Margin="0,0,0,8" Padding="12" />
                        <Button Content="Summarize" Margin="0,0,0,8" Padding="12" />
                        <Button Content="Rewrite" Margin="0,0,0,8" Padding="12" />
                        <Button Content="Grammar Fix" Margin="0,0,0,8" Padding="12" />
                        <Button Content="Ask AI" Padding="12" />
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="24,0,0,0"
                        Padding="20"
                        CornerRadius="16"
                        Background="#F1F5F9">
                    <StackPanel>
                        <TextBlock Text="Response preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AssistantTextBrush}" />
                        <TextBlock Margin="0,16,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource AssistantMutedTextBrush}"
                                   Text="This MVP scaffold wires the app shell, clean architecture boundaries, prompt actions, AI routing interfaces, selection detection stubs, and storage abstractions. Production global hooks, UI Automation extraction, secure clipboard fallback, provider clients, and persistent SQLite storage can now be implemented behind these contracts." />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
